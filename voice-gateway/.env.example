# Server
PORT=8080
PUBLIC_BASE_URL=https://your-public-wss-host.example
VOICE_GATEWAY_SECRET=replace-with-long-random-secret

# Meta Model API. Never commit real credentials.
META_MODEL_API_KEY=
META_MODEL_NAME=muse-spark-1.3
META_BASE_URL=https://api.meta.ai

# Muse Voice Transcribe realtime API
META_ASR_WS_URL=wss://api.meta.ai/v1/asr/realtime

# TTS adapter (ElevenLabs selected as an example; choose a plan/provider you can use)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Existing B8i backend
B8I_WORKER_URL=https://instagram-webhook.pramodh-rajoju-123.workers.dev
B8I_VOICE_API_TOKEN=
# Voice integration kill-switch. Keep false until live integration testing passes.
B8I_VOICE_ENABLED=false
# Optional server-to-server timeout in ms (default 8000, max 30000).
B8I_WORKER_TIMEOUT_MS=
# Public Instagram handle spoken to callers for LINK-code redemption (no @ needed).
B8I_INSTAGRAM_HANDLE=

# Exotel outbound API (optional; only after account/number/API access is verified)
EXOTEL_API_BASE=https://api.exotel.com
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
